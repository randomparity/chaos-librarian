        "stream": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stream"
        }
      },
      "required": [
        "profile",
        "event_id",
        "corruptor"
      ],
      "title": "CorruptionRecord",
      "type": "object"
    },
