        "$ref": "#/$defs/ManifestVariant"
      },
      "title": "Variants",
      "type": "array"
    },
    "versions": {
      "items": {
        "$ref": "#/$defs/ManifestVersion"
      },
      "title": "Versions",
      "type": "array"
    },
    "works": {
      "items": {
        "$ref": "#/$defs/ManifestWork"
      },
      "title": "Works",
      "type": "array"
    }
