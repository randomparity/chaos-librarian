{
  "$defs": {
    "CorruptionRecord": {
      "additionalProperties": false,
      "properties": {
        "byte_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Byte Count"
        },
        "byte_start": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Byte Start"
        },
        "corruptor": {
          "title": "Corruptor",
          "type": "string"
        },
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "title": "Metadata",
          "type": "object"
        },
        "packet_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Packet Count"
        },
        "packet_start": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Packet Start"
        },
        "profile": {
          "$ref": "#/$defs/ProfileName"
        },
        "seed_material": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed Material"
        },
        "stream": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stream"
        }
      },
      "required": [
        "profile",
        "event_id",
        "corruptor"
      ],
      "title": "CorruptionRecord",
      "type": "object"
    },
    "ManifestAsset": {
      "additionalProperties": false,
      "properties": {
        "bundle_id": {
          "title": "Bundle Id",
          "type": "string"
        },
        "container": {
          "title": "Container",
          "type": "string"
        },
        "duration_seconds": {
          "title": "Duration Seconds",
          "type": "number"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "role": {
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "id",
        "bundle_id",
        "role",
        "container",
        "duration_seconds"
      ],
      "title": "ManifestAsset",
      "type": "object"
    },
    "ManifestBundle": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "variant_id": {
          "title": "Variant Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "variant_id"
      ],
      "title": "ManifestBundle",
      "type": "object"
    },
    "ManifestLocation": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "title": "Asset Id",
          "type": "string"
        },
        "bytes_written": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bytes Written"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "temp_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temp Path"
        }
      },
      "required": [
        "id",
        "asset_id",
        "path"
      ],
      "title": "ManifestLocation",
      "type": "object"
    },
    "ManifestSidecar": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "title": "Asset Id",
          "type": "string"
        },
        "content_hash": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Hash"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Language"
        },
        "path": {
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "id",
        "asset_id",
        "kind",
        "path"
      ],
      "title": "ManifestSidecar",
      "type": "object"
    },
    "ManifestVariant": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "work_id": {
          "title": "Work Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "work_id",
        "label"
      ],
      "title": "ManifestVariant",
      "type": "object"
    },
    "ManifestVersion": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "title": "Asset Id",
          "type": "string"
        },
        "content_hash": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Hash"
        },
        "corruption": {
          "anyOf": [
            {
              "$ref": "#/$defs/CorruptionRecord"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "index": {
          "title": "Index",
          "type": "integer"
        },
        "probed": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProbedMedia"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "asset_id",
        "index"
      ],
      "title": "ManifestVersion",
      "type": "object"
    },
    "ManifestWork": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title"
      ],
      "title": "ManifestWork",
      "type": "object"
    },
    "ProbedMedia": {
      "additionalProperties": false,
      "description": "Output of ``ffprobe -show_format -show_streams`` mapped into a model.",
      "properties": {
        "container": {
          "title": "Container",
          "type": "string"
        },
        "duration_seconds": {
          "title": "Duration Seconds",
          "type": "number"
        },
        "size_bytes": {
          "title": "Size Bytes",
          "type": "integer"
        },
        "streams": {
          "items": {
            "$ref": "#/$defs/ProbedStream"
          },
          "title": "Streams",
          "type": "array"
        }
      },
      "required": [
        "container",
        "duration_seconds",
        "size_bytes",
        "streams"
      ],
      "title": "ProbedMedia",
      "type": "object"
    },
    "ProbedStream": {
      "additionalProperties": false,
      "description": "One stream from ``ffprobe -show_streams``.\n\nOptional fields are populated only for the matching ``kind``; ffprobe\nsilently omits the others, and ``exclude_none=True`` keeps the serialized\noutput compact.",
      "properties": {
        "channels": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Channels"
        },
        "codec": {
          "title": "Codec",
          "type": "string"
        },
        "default": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default"
        },
        "forced": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Forced"
        },
        "fps": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fps"
        },
        "height": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Height"
        },
        "kind": {
          "$ref": "#/$defs/StreamKind"
        },
        "language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Language"
        },
        "sample_rate": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sample Rate"
        },
        "width": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Width"
        }
      },
      "required": [
        "kind",
        "codec"
      ],
      "title": "ProbedStream",
      "type": "object"
    },
    "ProfileName": {
      "enum": [
        "malformed-media",
        "performance-smoke",
        "performance-scale",
        "performance-stress",
        "network-fs-lag",
        "filesystem-artifacts",
        "negative-oracle"
      ],
      "title": "ProfileName",
      "type": "string"
    },
    "StreamKind": {
      "description": "Kind of a probed media stream.",
      "enum": [
        "video",
        "audio",
        "subtitle"
      ],
      "title": "StreamKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assets": {
      "items": {
        "$ref": "#/$defs/ManifestAsset"
      },
      "title": "Assets",
      "type": "array"
    },
    "bundles": {
      "items": {
        "$ref": "#/$defs/ManifestBundle"
      },
      "title": "Bundles",
      "type": "array"
    },
    "locations": {
      "items": {
        "$ref": "#/$defs/ManifestLocation"
      },
      "title": "Locations",
      "type": "array"
    },
    "schema_version": {
      "const": 6,
      "title": "Schema Version",
      "type": "integer"
    },
    "sidecars": {
      "items": {
        "$ref": "#/$defs/ManifestSidecar"
      },
      "title": "Sidecars",
      "type": "array"
    },
    "variants": {
      "items": {
        "$ref": "#/$defs/ManifestVariant"
      },
      "title": "Variants",
      "type": "array"
    },
    "versions": {
      "items": {
        "$ref": "#/$defs/ManifestVersion"
      },
      "title": "Versions",
      "type": "array"
    },
    "works": {
      "items": {
        "$ref": "#/$defs/ManifestWork"
      },
      "title": "Works",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "works",
    "variants",
    "bundles",
    "assets",
    "versions",
    "locations"
  ],
  "title": "Manifest",
  "type": "object"
}
