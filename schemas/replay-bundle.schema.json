{
  "$defs": {
    "AllocTraceEntry": {
      "additionalProperties": false,
      "description": "Trace entry for an identifier/seed allocation. No ``exit_code``.",
      "properties": {
        "kind": {
          "const": "alloc",
          "title": "Kind",
          "type": "string"
        },
        "stream": {
          "title": "Stream",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "stream",
        "value",
        "kind"
      ],
      "title": "AllocTraceEntry",
      "type": "object"
    },
    "AudioNoiseColor": {
      "description": "Supported deterministic audio noise colors.",
      "enum": [
        "white",
        "pink",
        "brown"
      ],
      "title": "AudioNoiseColor",
      "type": "string"
    },
    "AudioSampleFormat": {
      "description": "Author-facing sample formats for probe-verifiable audio outputs.",
      "enum": [
        "s16",
        "s24",
        "flt"
      ],
      "title": "AudioSampleFormat",
      "type": "string"
    },
    "CacheDisposition": {
      "description": "How a provider used the content-source cache for one resolution.",
      "enum": [
        "not_cacheable",
        "hit",
        "miss_stored"
      ],
      "title": "CacheDisposition",
      "type": "string"
    },
    "ContentSourceEvidence": {
      "additionalProperties": false,
      "description": "Replay evidence for one resolved content source.",
      "properties": {
        "asset_id": {
          "title": "Asset Id",
          "type": "string"
        },
        "cache_disposition": {
          "$ref": "#/$defs/CacheDisposition"
        },
        "cache_key": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cache Key"
        },
        "color_range": {
          "anyOf": [
            {
              "$ref": "#/$defs/VideoColorRange"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "color_space": {
          "anyOf": [
            {
              "$ref": "#/$defs/VideoColorSpace"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "content_hash": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Hash"
        },
        "license": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License"
        },
        "noise_color": {
          "anyOf": [
            {
              "$ref": "#/$defs/AudioNoiseColor"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "origin_uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Origin Uri"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "recipe_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Recipe Digest",
          "type": "string"
        },
        "resolution_sequence": {
          "anyOf": [
            {
              "$ref": "#/$defs/VideoResolutionSequence"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sample_format": {
          "anyOf": [
            {
              "$ref": "#/$defs/AudioSampleFormat"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sample_rate": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sample Rate"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "track_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Track Index"
        },
        "track_kind": {
          "$ref": "#/$defs/ContentTrackKind"
        }
      },
      "required": [
        "asset_id",
        "track_kind",
        "source",
        "provider",
        "recipe_digest",
        "cache_disposition"
      ],
      "title": "ContentSourceEvidence",
      "type": "object"
    },
    "ContentTrackKind": {
      "description": "Track family a content source resolved.",
      "enum": [
        "video",
        "audio",
        "subtitle"
      ],
      "title": "ContentTrackKind",
      "type": "string"
    },
    "MaterializeReplayBundle": {
      "additionalProperties": false,
      "description": "Replay bundle in materialize or run mode.\n\n``applied_events`` was pinned to ``Literal[0]`` while materialize\nrejected non-empty timelines; Sprint 6 wires phase B into the\norchestrator and materialize now applies every resolved event, so the\nfield widens back to the base class's ``int = Field(ge=0)`` constraint\n(the plan-only and materialize modes agree on the same shape again).\n``created_at`` and ``toolchain`` are both required (non-null).",
      "properties": {
        "applied_events": {
          "minimum": 0,
          "title": "Applied Events",
          "type": "integer"
        },
        "chaos_librarian_version": {
          "title": "Chaos Librarian Version",
          "type": "string"
        },
        "content_sources": {
          "items": {
            "$ref": "#/$defs/ContentSourceEvidence"
          },
          "title": "Content Sources",
          "type": "array"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "execution_mode": {
          "enum": [
            "materialize",
            "run"
          ],
          "title": "Execution Mode",
          "type": "string"
        },
        "execution_trace": {
          "items": {
            "discriminator": {
              "mapping": {
                "alloc": "#/$defs/AllocTraceEntry",
                "materializer": "#/$defs/MaterializerTraceEntry",
                "rng": "#/$defs/RngTraceEntry"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/RngTraceEntry"
              },
              {
                "$ref": "#/$defs/AllocTraceEntry"
              },
              {
                "$ref": "#/$defs/MaterializerTraceEntry"
              }
            ]
          },
          "title": "Execution Trace",
          "type": "array"
        },
        "journal_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Journal Digest",
          "type": "string"
        },
        "resolved_seed": {
          "title": "Resolved Seed",
          "type": "integer"
        },
        "run_id": {
          "format": "uuid",
          "title": "Run Id",
          "type": "string"
        },
        "scenario": {
          "title": "Scenario",
          "type": "string"
        },
        "schema_version": {
          "const": 10,
          "title": "Schema Version",
          "type": "integer"
        },
        "toolchain": {
          "$ref": "#/$defs/ToolchainInfo"
        }
      },
      "required": [
        "schema_version",
        "chaos_librarian_version",
        "scenario",
        "run_id",
        "resolved_seed",
        "applied_events",
        "journal_digest",
        "execution_mode",
        "created_at",
        "toolchain",
        "content_sources"
      ],
      "title": "MaterializeReplayBundle",
      "type": "object"
    },
    "MaterializerTraceEntry": {
      "additionalProperties": false,
      "description": "Trace entry for a materializer subprocess. ``exit_code`` is required.",
      "properties": {
        "exit_code": {
          "title": "Exit Code",
          "type": "integer"
        },
        "kind": {
          "const": "materializer",
          "title": "Kind",
          "type": "string"
        },
        "stream": {
          "title": "Stream",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "stream",
        "value",
        "kind",
        "exit_code"
      ],
      "title": "MaterializerTraceEntry",
      "type": "object"
    },
    "PlanOnlyReplayBundle": {
      "additionalProperties": false,
      "description": "Replay bundle in plan-only mode. No ``created_at`` or ``toolchain``.",
      "properties": {
        "applied_events": {
          "minimum": 0,
          "title": "Applied Events",
          "type": "integer"
        },
        "chaos_librarian_version": {
          "title": "Chaos Librarian Version",
          "type": "string"
        },
        "execution_mode": {
          "const": "plan_only",
          "default": "plan_only",
          "title": "Execution Mode",
          "type": "string"
        },
        "execution_trace": {
          "items": {
            "discriminator": {
              "mapping": {
                "alloc": "#/$defs/AllocTraceEntry",
                "materializer": "#/$defs/MaterializerTraceEntry",
                "rng": "#/$defs/RngTraceEntry"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/RngTraceEntry"
              },
              {
                "$ref": "#/$defs/AllocTraceEntry"
              },
              {
                "$ref": "#/$defs/MaterializerTraceEntry"
              }
            ]
          },
          "title": "Execution Trace",
          "type": "array"
        },
        "journal_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Journal Digest",
          "type": "string"
        },
        "resolved_seed": {
          "title": "Resolved Seed",
          "type": "integer"
        },
        "run_id": {
          "format": "uuid",
          "title": "Run Id",
          "type": "string"
        },
        "scenario": {
          "title": "Scenario",
          "type": "string"
        },
        "schema_version": {
          "const": 10,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "chaos_librarian_version",
        "scenario",
        "run_id",
        "resolved_seed",
        "applied_events",
        "journal_digest"
      ],
      "title": "PlanOnlyReplayBundle",
      "type": "object"
    },
    "RngTraceEntry": {
      "additionalProperties": false,
      "description": "Trace entry for an RNG draw. No ``exit_code``.",
      "properties": {
        "kind": {
          "const": "rng",
          "title": "Kind",
          "type": "string"
        },
        "stream": {
          "title": "Stream",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "stream",
        "value",
        "kind"
      ],
      "title": "RngTraceEntry",
      "type": "object"
    },
    "ToolchainInfo": {
      "additionalProperties": false,
      "description": "Versions of the external tools used during materialization.\n\nShared with ``MaterializeReplayBundle`` so consumers see one shape.\nEvery field is optional because a tool may be missing on a system\nthat nevertheless succeeded at static materialize (for example,\nmkvtoolnix is only required for media-mutation modes).",
      "properties": {
        "ffmpeg": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ffmpeg"
        },
        "ffprobe": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ffprobe"
        },
        "mkvtoolnix": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mkvtoolnix"
        }
      },
      "title": "ToolchainInfo",
      "type": "object"
    },
    "VideoColorRange": {
      "description": "Supported video color-range signaling values.",
      "enum": [
        "limited",
        "full"
      ],
      "title": "VideoColorRange",
      "type": "string"
    },
    "VideoColorSpace": {
      "description": "Supported SDR video color-space signaling values.",
      "enum": [
        "bt601",
        "bt709",
        "bt2020"
      ],
      "title": "VideoColorSpace",
      "type": "string"
    },
    "VideoResolutionSequence": {
      "description": "Supported mid-stream video resolution transitions.",
      "enum": [
        "sd_to_hd"
      ],
      "title": "VideoResolutionSequence",
      "type": "string"
    }
  },
  "discriminator": {
    "mapping": {
      "materialize": "#/$defs/MaterializeReplayBundle",
      "plan_only": "#/$defs/PlanOnlyReplayBundle",
      "run": "#/$defs/MaterializeReplayBundle"
    },
    "propertyName": "execution_mode"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/PlanOnlyReplayBundle"
    },
    {
      "$ref": "#/$defs/MaterializeReplayBundle"
    }
  ]
}
