{
  "$defs": {
    "AllocTraceEntry": {
      "additionalProperties": false,
      "description": "Trace entry for an identifier/seed allocation. No ``exit_code``.",
      "properties": {
        "kind": {
          "const": "alloc",
          "title": "Kind",
          "type": "string"
        },
        "stream": {
          "title": "Stream",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "stream",
        "value",
        "kind"
      ],
      "title": "AllocTraceEntry",
      "type": "object"
    },
    "MaterializeReplayBundle": {
      "additionalProperties": false,
      "description": "Replay bundle in materialize or run mode.\n\n``applied_events`` is pinned to 0 in Sprint 5 because every materialize\ntimeline is empty; the base class constraint will widen again in Sprint 6.\n``created_at`` and ``toolchain`` are both required (non-null).",
      "properties": {
        "applied_events": {
          "const": 0,
          "default": 0,
          "title": "Applied Events",
          "type": "integer"
        },
        "chaos_librarian_version": {
          "title": "Chaos Librarian Version",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "execution_mode": {
          "enum": [
            "materialize",
            "run"
          ],
          "title": "Execution Mode",
          "type": "string"
        },
        "execution_trace": {
          "items": {
            "discriminator": {
              "mapping": {
                "alloc": "#/$defs/AllocTraceEntry",
                "materializer": "#/$defs/MaterializerTraceEntry",
                "rng": "#/$defs/RngTraceEntry"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/RngTraceEntry"
              },
              {
                "$ref": "#/$defs/AllocTraceEntry"
              },
              {
                "$ref": "#/$defs/MaterializerTraceEntry"
              }
            ]
          },
          "title": "Execution Trace",
          "type": "array"
        },
        "journal_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Journal Digest",
          "type": "string"
        },
        "resolved_seed": {
          "title": "Resolved Seed",
          "type": "integer"
        },
        "run_id": {
          "format": "uuid",
          "title": "Run Id",
          "type": "string"
        },
        "scenario": {
          "title": "Scenario",
          "type": "string"
        },
        "schema_version": {
          "const": 3,
          "title": "Schema Version",
          "type": "integer"
        },
        "toolchain": {
          "$ref": "#/$defs/ToolchainInfo"
        }
      },
      "required": [
        "schema_version",
        "chaos_librarian_version",
        "scenario",
        "run_id",
        "resolved_seed",
        "journal_digest",
        "execution_mode",
        "created_at",
        "toolchain"
      ],
      "title": "MaterializeReplayBundle",
      "type": "object"
    },
    "MaterializerTraceEntry": {
      "additionalProperties": false,
      "description": "Trace entry for a materializer subprocess. ``exit_code`` is required.",
      "properties": {
        "exit_code": {
          "title": "Exit Code",
          "type": "integer"
        },
        "kind": {
          "const": "materializer",
          "title": "Kind",
          "type": "string"
        },
        "stream": {
          "title": "Stream",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "stream",
        "value",
        "kind",
        "exit_code"
      ],
      "title": "MaterializerTraceEntry",
      "type": "object"
    },
    "PlanOnlyReplayBundle": {
      "additionalProperties": false,
      "description": "Replay bundle in plan-only mode. No ``created_at`` or ``toolchain``.",
      "properties": {
        "applied_events": {
          "minimum": 0,
          "title": "Applied Events",
          "type": "integer"
        },
        "chaos_librarian_version": {
          "title": "Chaos Librarian Version",
          "type": "string"
        },
        "execution_mode": {
          "const": "plan_only",
          "default": "plan_only",
          "title": "Execution Mode",
          "type": "string"
        },
        "execution_trace": {
          "items": {
            "discriminator": {
              "mapping": {
                "alloc": "#/$defs/AllocTraceEntry",
                "materializer": "#/$defs/MaterializerTraceEntry",
                "rng": "#/$defs/RngTraceEntry"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/RngTraceEntry"
              },
              {
                "$ref": "#/$defs/AllocTraceEntry"
              },
              {
                "$ref": "#/$defs/MaterializerTraceEntry"
              }
            ]
          },
          "title": "Execution Trace",
          "type": "array"
        },
        "journal_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Journal Digest",
          "type": "string"
        },
        "resolved_seed": {
          "title": "Resolved Seed",
          "type": "integer"
        },
        "run_id": {
          "format": "uuid",
          "title": "Run Id",
          "type": "string"
        },
        "scenario": {
          "title": "Scenario",
          "type": "string"
        },
        "schema_version": {
          "const": 3,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "chaos_librarian_version",
        "scenario",
        "run_id",
        "resolved_seed",
        "applied_events",
        "journal_digest"
      ],
      "title": "PlanOnlyReplayBundle",
      "type": "object"
    },
    "RngTraceEntry": {
      "additionalProperties": false,
      "description": "Trace entry for an RNG draw. No ``exit_code``.",
      "properties": {
        "kind": {
          "const": "rng",
          "title": "Kind",
          "type": "string"
        },
        "stream": {
          "title": "Stream",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "stream",
        "value",
        "kind"
      ],
      "title": "RngTraceEntry",
      "type": "object"
    },
    "ToolchainInfo": {
      "additionalProperties": false,
      "description": "Versions of the external tools used during materialization.\n\nShared with ``MaterializeReplayBundle`` so consumers see one shape.\nEvery field is optional because a tool may be missing on a system that\nnevertheless succeeded at static materialize (mkvtoolnix in Sprint 5).",
      "properties": {
        "ffmpeg": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ffmpeg"
        },
        "ffprobe": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ffprobe"
        },
        "mkvtoolnix": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mkvtoolnix"
        }
      },
      "title": "ToolchainInfo",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "materialize": "#/$defs/MaterializeReplayBundle",
      "plan_only": "#/$defs/PlanOnlyReplayBundle",
      "run": "#/$defs/MaterializeReplayBundle"
    },
    "propertyName": "execution_mode"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/PlanOnlyReplayBundle"
    },
    {
      "$ref": "#/$defs/MaterializeReplayBundle"
    }
  ]
}
