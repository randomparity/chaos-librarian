        "observed_ref": {
          "title": "Observed Ref",
          "type": "string"
        },
        "release_year": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Release Year"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        }
      },
      "required": [
        "observed_ref",
        "artist_ref"
      ],
      "title": "ObservedAlbum",
      "type": "object"
    },
