    "ObservedAction": {
      "description": "Path-affecting action vocabulary accepted from consumers.",
      "enum": [
        "move_asset",
        "rename_file",
        "delete_file",
        "add_file",
        "slow_copy_start",
        "slow_copy_commit",
        "archive_file",
        "move_between_roots",
        "renumber_episode",
        "move_episode_to_season",
        "rename_season",
        "renumber_disc",
        "move_track_to_disc"
      ],
      "title": "ObservedAction",
      "type": "string"
    },
    "ObservedAlbum": {
      "additionalProperties": false,
      "properties": {
        "artist_ref": {
          "title": "Artist Ref",
          "type": "string"
