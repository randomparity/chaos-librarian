      "type": "string"
    },
    "library": {
      "$ref": "#/$defs/Library"
    },
    "scenario_id": {
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "const": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "seed": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "const": "random",
          "type": "string"
        }
      ],
      "title": "Seed"
    },
    "timeline": {
      "items": {
        "discriminator": {
          "mapping": {
            "add_file": "#/$defs/AddFileEvent",
            "create_sidecar": "#/$defs/CreateSidecarEvent",
            "delete_file": "#/$defs/DeleteFileEvent",
            "move_asset": "#/$defs/MoveAssetEvent",
            "reencode_audio": "#/$defs/ReencodeAudioEvent",
            "reencode_video": "#/$defs/ReencodeVideoEvent",
            "rename_file": "#/$defs/RenameFileEvent",
            "slow_copy_commit": "#/$defs/SlowCopyCommitEvent",
            "slow_copy_start": "#/$defs/SlowCopyStartEvent"
          },
          "propertyName": "action"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/MoveAssetEvent"
          },
          {
            "$ref": "#/$defs/RenameFileEvent"
          },
          {
            "$ref": "#/$defs/DeleteFileEvent"
          },
          {
            "$ref": "#/$defs/AddFileEvent"
          },
          {
            "$ref": "#/$defs/ReencodeVideoEvent"
          },
          {
            "$ref": "#/$defs/ReencodeAudioEvent"
          },
          {
            "$ref": "#/$defs/CreateSidecarEvent"
          },
          {
            "$ref": "#/$defs/SlowCopyStartEvent"
          },
          {
            "$ref": "#/$defs/SlowCopyCommitEvent"
          }
        ]
      },
      "title": "Timeline",
      "type": "array"
    },
    "works": {
      "items": {
        "$ref": "#/$defs/Work"
      },
      "title": "Works",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "scenario_id",
    "seed",
    "duration_scale",
    "library",
    "works",
    "timeline"
  ],
  "title": "Scenario",
  "type": "object"
