{
  "$defs": {
    "AudioNoiseColor": {
      "description": "Supported deterministic audio noise colors.",
      "enum": [
        "white",
        "pink",
        "brown"
      ],
      "title": "AudioNoiseColor",
      "type": "string"
    },
    "AudioSampleFormat": {
      "description": "Author-facing sample formats for probe-verifiable audio outputs.",
      "enum": [
        "s16",
        "s24",
        "flt"
      ],
      "title": "AudioSampleFormat",
      "type": "string"
    },
    "CacheDisposition": {
      "description": "How a provider used the content-source cache for one resolution.",
      "enum": [
        "not_cacheable",
        "hit",
        "miss_stored"
      ],
      "title": "CacheDisposition",
      "type": "string"
    },
    "ContentSourceEvidence": {
      "additionalProperties": false,
      "description": "Replay evidence for one resolved content source.",
      "properties": {
        "asset_id": {
          "title": "Asset Id",
          "type": "string"
        },
        "cache_disposition": {
          "$ref": "#/$defs/CacheDisposition"
        },
        "cache_key": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cache Key"
        },
        "chapter_count": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Chapter Count"
        },
        "chapter_title_prefix": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Chapter Title Prefix"
        },
        "color_range": {
          "anyOf": [
            {
              "$ref": "#/$defs/VideoColorRange"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "color_space": {
          "anyOf": [
            {
              "$ref": "#/$defs/VideoColorSpace"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "content_hash": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Hash"
        },
        "cover_art_color": {
          "anyOf": [
            {
              "pattern": "^#[0-9a-f]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cover Art Color"
        },
        "cover_art_image_format": {
          "anyOf": [
            {
              "$ref": "#/$defs/CoverArtImageFormat"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "cover_art_resolution": {
          "anyOf": [
            {
              "$ref": "#/$defs/CoverArtResolution"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "license": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License"
        },
        "noise_color": {
          "anyOf": [
            {
              "$ref": "#/$defs/AudioNoiseColor"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "origin_uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Origin Uri"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "recipe_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Recipe Digest",
          "type": "string"
        },
        "resolution_sequence": {
          "anyOf": [
            {
              "$ref": "#/$defs/VideoResolutionSequence"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sample_format": {
          "anyOf": [
            {
              "$ref": "#/$defs/AudioSampleFormat"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sample_rate": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sample Rate"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "track_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Track Index"
        },
        "track_kind": {
          "$ref": "#/$defs/ContentTrackKind"
        }
      },
      "required": [
        "asset_id",
        "track_kind",
        "source",
        "provider",
        "recipe_digest",
        "cache_disposition"
      ],
      "title": "ContentSourceEvidence",
      "type": "object"
    },
    "ContentTrackKind": {
      "description": "Track family a content source resolved.",
      "enum": [
        "video",
        "audio",
        "subtitle",
        "chapters",
        "cover_art"
      ],
      "title": "ContentTrackKind",
      "type": "string"
    },
    "CorruptionAction": {
      "additionalProperties": false,
      "description": "One phase-B intentional corruption audit record.",
      "properties": {
        "action": {
          "enum": [
            "corrupt_container_header",
            "truncate_file",
            "corrupt_packet_range",
            "write_invalid_duration_metadata"
          ],
          "title": "Action",
          "type": "string"
        },
        "byte_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Byte Count"
        },
        "byte_start": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Byte Start"
        },
        "corruptor": {
          "title": "Corruptor",
          "type": "string"
        },
        "duration_ns": {
          "title": "Duration Ns",
          "type": "integer"
        },
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "input_content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Input Content Hash",
          "type": "string"
        },
        "input_path": {
          "title": "Input Path",
          "type": "string"
        },
        "input_size_bytes": {
          "title": "Input Size Bytes",
          "type": "integer"
        },
        "input_version_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Version Id"
        },
        "metadata": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "title": "Metadata",
          "type": "object"
        },
        "output_content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Output Content Hash",
          "type": "string"
        },
        "output_path": {
          "title": "Output Path",
          "type": "string"
        },
        "output_size_bytes": {
          "title": "Output Size Bytes",
          "type": "integer"
        },
        "output_version_id": {
          "title": "Output Version Id",
          "type": "string"
        },
        "packet_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Packet Count"
        },
        "packet_start": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Packet Start"
        },
        "probe_error_tail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Probe Error Tail"
        },
        "probe_outcome": {
          "$ref": "#/$defs/CorruptionProbeOutcome"
        },
        "seed_material": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed Material"
        },
        "stream": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stream"
        },
        "target_asset_id": {
          "title": "Target Asset Id",
          "type": "string"
        }
      },
      "required": [
        "event_id",
        "action",
        "target_asset_id",
        "input_path",
        "output_path",
        "output_version_id",
        "input_content_hash",
        "output_content_hash",
        "corruptor",
        "input_size_bytes",
        "output_size_bytes",
        "probe_outcome",
        "duration_ns"
      ],
      "title": "CorruptionAction",
      "type": "object"
    },
    "CorruptionProbeOutcome": {
      "enum": [
        "failed_expected",
        "still_probeable"
      ],
      "title": "CorruptionProbeOutcome",
      "type": "string"
    },
    "CoverArtImageFormat": {
      "description": "Image format for embedded cover art.",
      "enum": [
        "png"
      ],
      "title": "CoverArtImageFormat",
      "type": "string"
    },
    "CoverArtResolution": {
      "description": "Pixel geometry for embedded cover art.",
      "enum": [
        "square_320"
      ],
      "title": "CoverArtResolution",
      "type": "string"
    },
    "FailureStage": {
      "description": "Subprocess stage that produced a MaterializationFailure.",
      "enum": [
        "ffmpeg",
        "ffprobe",
        "filesystem",
        "media",
        "corruption"
      ],
      "title": "FailureStage",
      "type": "string"
    },
    "FilesystemAction": {
      "additionalProperties": false,
      "description": "One phase-B filesystem operation audit record.\n\nMirrors ``ToolInvocation``'s role for subprocesses: one record per\njournal entry that produced a real disk change.",
      "properties": {
        "action": {
          "$ref": "#/$defs/TimelineActionName"
        },
        "content_hash": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Hash"
        },
        "duration_ns": {
          "title": "Duration Ns",
          "type": "integer"
        },
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "from_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "From Path"
        },
        "mtime_after_ns": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mtime After Ns"
        },
        "mtime_before_ns": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mtime Before Ns"
        },
        "target_asset_id": {
          "title": "Target Asset Id",
          "type": "string"
        },
        "temp_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temp Path"
        },
        "to_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "To Path"
        }
      },
      "required": [
        "event_id",
        "action",
        "target_asset_id",
        "duration_ns"
      ],
      "title": "FilesystemAction",
      "type": "object"
    },
    "MaterializationExecutionMode": {
      "description": "Mode that produced the materialization report.",
      "enum": [
        "materialize",
        "run"
      ],
      "title": "MaterializationExecutionMode",
      "type": "string"
    },
    "MaterializationFailure": {
      "additionalProperties": false,
      "description": "Per-failure record.\n\n``asset_id`` is None for non-per-asset stages (e.g. capability\nregression). ``invocation_index`` indexes into ``invocations`` when the\nfailure came from a subprocess call.",
      "properties": {
        "asset_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Asset Id"
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exit Code"
        },
        "invocation_index": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Invocation Index"
        },
        "stage": {
          "$ref": "#/$defs/FailureStage"
        },
        "stderr_tail": {
          "title": "Stderr Tail",
          "type": "string"
        }
      },
      "required": [
        "stage",
        "stderr_tail"
      ],
      "title": "MaterializationFailure",
      "type": "object"
    },
    "MaterializedAsset": {
      "additionalProperties": false,
      "description": "Per-asset success record.",
      "properties": {
        "asset_id": {
          "title": "Asset Id",
          "type": "string"
        },
        "content_hash": {
          "title": "Content Hash",
          "type": "string"
        },
        "duration_seconds": {
          "title": "Duration Seconds",
          "type": "number"
        },
        "invocation_index": {
          "title": "Invocation Index",
          "type": "integer"
        },
        "location_path": {
          "title": "Location Path",
          "type": "string"
        },
        "mp4_moov_placement": {
          "anyOf": [
            {
              "$ref": "#/$defs/Mp4MoovPlacement"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "size_bytes": {
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "asset_id",
        "location_path",
        "content_hash",
        "size_bytes",
        "duration_seconds",
        "invocation_index"
      ],
      "title": "MaterializedAsset",
      "type": "object"
    },
    "MediaAction": {
      "additionalProperties": false,
      "description": "One phase-B media operation audit record.\n\nParallel to ``FilesystemAction``: one record per journal entry that\nproduced a real byte / probed-metadata change via ffmpeg or\nsidecar-regeneration. ``tool_invocation_index`` cross-refs into\n``MaterializationReport.invocations`` so consumers can join the two\naudit streams.",
      "properties": {
        "action": {
          "$ref": "#/$defs/TimelineActionName"
        },
        "duration_ns": {
          "title": "Duration Ns",
          "type": "integer"
        },
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "input_content_hash": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Content Hash"
        },
        "input_path": {
          "title": "Input Path",
          "type": "string"
        },
        "input_version_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Version Id"
        },
        "output_content_hash": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Content Hash"
        },
        "output_path": {
          "title": "Output Path",
          "type": "string"
        },
        "output_sidecar_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Sidecar Id"
        },
        "output_version_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Version Id"
        },
        "target_asset_id": {
          "title": "Target Asset Id",
          "type": "string"
        },
        "tool_invocation_index": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Invocation Index"
        }
      },
      "required": [
        "event_id",
        "action",
        "target_asset_id",
        "input_path",
        "output_path",
        "duration_ns"
      ],
      "title": "MediaAction",
      "type": "object"
    },
    "Mp4MoovPlacement": {
      "description": "MP4 top-level moov atom placement requested at mux time.",
      "enum": [
        "moov_at_start",
        "moov_at_end"
      ],
      "title": "Mp4MoovPlacement",
      "type": "string"
    },
    "NetworkLagAction": {
      "additionalProperties": false,
      "description": "One watcher-visible network filesystem lag audit record.",
      "properties": {
        "actual_duration_ns": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual Duration Ns"
        },
        "after_event_id": {
          "title": "After Event Id",
          "type": "string"
        },
        "commit_event_id": {
          "title": "Commit Event Id",
          "type": "string"
        },
        "effect": {
          "$ref": "#/$defs/NetworkLagEffect"
        },
        "enforced": {
          "title": "Enforced",
          "type": "boolean"
        },
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "from_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "From Path"
        },
        "logical_commit_ns": {
          "title": "Logical Commit Ns",
          "type": "integer"
        },
        "logical_start_ns": {
          "title": "Logical Start Ns",
          "type": "integer"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "requested_duration_ns": {
          "title": "Requested Duration Ns",
          "type": "integer"
        },
        "target_ref": {
          "title": "Target Ref",
          "type": "string"
        },
        "to_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "To Path"
        }
      },
      "required": [
        "event_id",
        "commit_event_id",
        "effect",
        "target_ref",
        "after_event_id",
        "logical_start_ns",
        "logical_commit_ns",
        "requested_duration_ns",
        "provider",
        "enforced"
      ],
      "title": "NetworkLagAction",
      "type": "object"
    },
    "NetworkLagEffect": {
      "description": "Watcher-visible filesystem lag artifact requested by a lag window.",
      "enum": [
        "delayed_visibility",
        "delayed_rename",
        "held_handle"
      ],
      "title": "NetworkLagEffect",
      "type": "string"
    },
    "OracleHashAction": {
      "additionalProperties": false,
      "description": "One negative-oracle audit record with divergent reported hash.",
      "properties": {
        "action": {
          "const": "wrong_oracle_hash",
          "title": "Action",
          "type": "string"
        },
        "actual_content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Actual Content Hash",
          "type": "string"
        },
        "duration_ns": {
          "title": "Duration Ns",
          "type": "integer"
        },
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "input_path": {
          "title": "Input Path",
          "type": "string"
        },
        "input_version_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Version Id"
        },
        "output_path": {
          "title": "Output Path",
          "type": "string"
        },
        "output_version_id": {
          "title": "Output Version Id",
          "type": "string"
        },
        "reported_content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Reported Content Hash",
          "type": "string"
        },
        "seed_material": {
          "title": "Seed Material",
          "type": "string"
        },
        "target_asset_id": {
          "title": "Target Asset Id",
          "type": "string"
        }
      },
      "required": [
        "event_id",
        "action",
        "target_asset_id",
        "input_path",
        "output_path",
        "output_version_id",
        "actual_content_hash",
        "reported_content_hash",
        "seed_material",
        "duration_ns"
      ],
      "title": "OracleHashAction",
      "type": "object"
    },
    "Outcome": {
      "description": "High-level materialize result.\n\n``unsupported`` covers both timeline-rejection and matrix-rejection.\n``tool_failed`` covers both ffmpeg subprocess errors and ffprobe parse\nfailures.",
      "enum": [
        "success",
        "unsupported",
        "tool_failed",
        "tool_missing",
        "containment_violation",
        "fs_failed",
        "media_failed",
        "corruption_failed"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "TimelineActionName": {
      "description": "All valid ``action:`` values for a timeline event.\n\nThis is the single source of truth: discriminator literals on the\nvariant classes below, the JSONPath formatter in ``validation.codes``,\nand the per-action path-field map in ``validation.semantic`` all\nreference these members instead of bare strings.",
      "enum": [
        "move_asset",
        "rename_file",
        "delete_file",
