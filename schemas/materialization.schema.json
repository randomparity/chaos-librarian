{
  "$defs": {
    "FailureStage": {
      "description": "Subprocess stage that produced a MaterializationFailure.",
      "enum": [
        "ffmpeg",
        "ffprobe"
      ],
      "title": "FailureStage",
      "type": "string"
    },
    "MaterializationFailure": {
      "additionalProperties": false,
      "description": "Per-failure record.\n\n``asset_id`` is None for non-per-asset stages (e.g. capability\nregression). ``invocation_index`` indexes into ``invocations`` when the\nfailure came from a subprocess call.",
      "properties": {
        "asset_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Asset Id"
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Exit Code"
        },
        "invocation_index": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Invocation Index"
        },
        "stage": {
          "$ref": "#/$defs/FailureStage"
        },
        "stderr_tail": {
          "title": "Stderr Tail",
          "type": "string"
        }
      },
      "required": [
        "asset_id",
        "stage",
        "exit_code",
        "stderr_tail",
        "invocation_index"
      ],
      "title": "MaterializationFailure",
      "type": "object"
    },
    "MaterializedAsset": {
      "additionalProperties": false,
      "description": "Per-asset success record.",
      "properties": {
        "asset_id": {
          "title": "Asset Id",
          "type": "string"
        },
        "content_hash": {
          "title": "Content Hash",
          "type": "string"
        },
        "duration_seconds": {
          "title": "Duration Seconds",
          "type": "number"
        },
        "invocation_index": {
          "title": "Invocation Index",
          "type": "integer"
        },
        "location_path": {
          "title": "Location Path",
          "type": "string"
        },
        "size_bytes": {
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "asset_id",
        "location_path",
        "content_hash",
        "size_bytes",
        "duration_seconds",
        "invocation_index"
      ],
      "title": "MaterializedAsset",
      "type": "object"
    },
    "Outcome": {
      "description": "High-level materialize result.\n\n``unsupported`` covers both timeline-rejection and matrix-rejection.\n``tool_failed`` covers both ffmpeg subprocess errors and ffprobe parse\nfailures.",
      "enum": [
        "success",
        "unsupported",
        "tool_failed",
        "tool_missing",
        "containment_violation"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "ToolInvocation": {
      "additionalProperties": false,
      "description": "One subprocess invocation captured for the replay bundle and report.",
      "properties": {
        "command": {
          "items": {
            "type": "string"
          },
          "title": "Command",
          "type": "array"
        },
        "duration_ns": {
          "title": "Duration Ns",
          "type": "integer"
        },
        "exit_code": {
          "title": "Exit Code",
          "type": "integer"
        },
        "tool": {
          "title": "Tool",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "tool",
        "version",
        "command",
        "exit_code",
        "duration_ns"
      ],
      "title": "ToolInvocation",
      "type": "object"
    },
    "ToolchainInfo": {
      "additionalProperties": false,
      "description": "Versions of the external tools used during materialization.\n\nShared with ``MaterializeReplayBundle`` so consumers see one shape.\nEvery field is optional because a tool may be missing on a system\nthat nevertheless succeeded at static materialize (for example,\nmkvtoolnix is only required for media-mutation modes).",
      "properties": {
        "ffmpeg": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ffmpeg"
        },
        "ffprobe": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ffprobe"
        },
        "mkvtoolnix": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mkvtoolnix"
        }
      },
      "title": "ToolchainInfo",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Top-level ``materialization.json`` body.",
  "properties": {
    "failures": {
      "items": {
        "$ref": "#/$defs/MaterializationFailure"
      },
      "title": "Failures",
      "type": "array"
    },
    "finished_at": {
      "format": "date-time",
      "title": "Finished At",
      "type": "string"
    },
    "invocations": {
      "items": {
        "$ref": "#/$defs/ToolInvocation"
      },
      "title": "Invocations",
      "type": "array"
    },
    "materialized": {
      "items": {
        "$ref": "#/$defs/MaterializedAsset"
      },
      "title": "Materialized",
      "type": "array"
    },
    "outcome": {
      "$ref": "#/$defs/Outcome"
    },
    "platform": {
      "title": "Platform",
      "type": "string"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "toolchain": {
      "$ref": "#/$defs/ToolchainInfo"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "outcome",
    "platform",
    "started_at",
    "finished_at",
    "toolchain"
  ],
  "title": "MaterializationReport",
  "type": "object"
}
