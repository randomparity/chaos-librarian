{
  "$defs": {
    "MaterializationStatus": {
      "enum": [
        "ok",
        "tool_missing",
        "tool_failed",
        "containment_violation"
      ],
      "title": "MaterializationStatus",
      "type": "string"
    },
    "ToolInvocation": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "items": {
            "type": "string"
          },
          "title": "Command",
          "type": "array"
        },
        "duration_ns": {
          "title": "Duration Ns",
          "type": "integer"
        },
        "exit_code": {
          "title": "Exit Code",
          "type": "integer"
        },
        "tool": {
          "title": "Tool",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "tool",
        "version",
        "command",
        "exit_code",
        "duration_ns"
      ],
      "title": "ToolInvocation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "invocations": {
      "items": {
        "$ref": "#/$defs/ToolInvocation"
      },
      "title": "Invocations",
      "type": "array"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "status": {
      "$ref": "#/$defs/MaterializationStatus"
    },
    "toolchain": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Toolchain",
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "status",
    "toolchain"
  ],
  "title": "MaterializationReport",
  "type": "object"
}
