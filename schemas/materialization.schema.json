{
  "$defs": {
    "CacheDisposition": {
      "description": "How a provider used the content-source cache for one resolution.",
      "enum": [
        "not_cacheable",
        "hit",
        "miss_stored"
      ],
      "title": "CacheDisposition",
      "type": "string"
    },
    "ContentSourceEvidence": {
      "additionalProperties": false,
      "description": "Replay evidence for one resolved content source.",
      "properties": {
        "asset_id": {
          "title": "Asset Id",
          "type": "string"
        },
        "cache_disposition": {
          "$ref": "#/$defs/CacheDisposition"
        },
        "cache_key": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cache Key"
        },
        "content_hash": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Hash"
        },
        "license": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License"
        },
        "origin_uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Origin Uri"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "recipe_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Recipe Digest",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "track_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Track Index"
        },
        "track_kind": {
          "$ref": "#/$defs/ContentTrackKind"
        }
      },
      "required": [
        "asset_id",
        "track_kind",
        "source",
        "provider",
        "recipe_digest",
        "cache_disposition"
      ],
      "title": "ContentSourceEvidence",
      "type": "object"
    },
    "ContentTrackKind": {
      "description": "Track family a content source resolved.",
      "enum": [
        "video",
        "audio",
        "subtitle"
      ],
      "title": "ContentTrackKind",
      "type": "string"
    },
    "CorruptionAction": {
      "additionalProperties": false,
      "description": "One phase-B intentional corruption audit record.",
      "properties": {
        "action": {
          "const": "corrupt_container_header",
          "title": "Action",
          "type": "string"
        },
        "byte_count": {
          "title": "Byte Count",
          "type": "integer"
        },
        "byte_start": {
          "title": "Byte Start",
          "type": "integer"
        },
        "corruptor": {
          "title": "Corruptor",
          "type": "string"
        },
        "duration_ns": {
          "title": "Duration Ns",
          "type": "integer"
        },
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "input_content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Input Content Hash",
          "type": "string"
        },
        "input_path": {
          "title": "Input Path",
          "type": "string"
        },
        "input_version_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Version Id"
        },
        "output_content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Output Content Hash",
          "type": "string"
        },
        "output_path": {
          "title": "Output Path",
          "type": "string"
        },
        "output_version_id": {
          "title": "Output Version Id",
          "type": "string"
        },
        "probe_error_tail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Probe Error Tail"
        },
        "probe_outcome": {
          "$ref": "#/$defs/CorruptionProbeOutcome"
        },
        "seed_material": {
          "title": "Seed Material",
          "type": "string"
        },
        "target_asset_id": {
          "title": "Target Asset Id",
          "type": "string"
        }
      },
      "required": [
        "event_id",
        "action",
        "target_asset_id",
        "input_path",
        "output_path",
        "output_version_id",
        "input_content_hash",
        "output_content_hash",
        "corruptor",
        "byte_start",
        "byte_count",
        "seed_material",
        "probe_outcome",
        "duration_ns"
      ],
      "title": "CorruptionAction",
      "type": "object"
    },
    "CorruptionProbeOutcome": {
      "enum": [
        "failed_expected",
        "still_probeable"
      ],
      "title": "CorruptionProbeOutcome",
      "type": "string"
    },
    "FailureStage": {
      "description": "Subprocess stage that produced a MaterializationFailure.",
      "enum": [
        "ffmpeg",
        "ffprobe",
        "filesystem",
        "media",
        "corruption"
      ],
      "title": "FailureStage",
      "type": "string"
    },
    "FilesystemAction": {
      "additionalProperties": false,
      "description": "One phase-B filesystem operation audit record.\n\nMirrors ``ToolInvocation``'s role for subprocesses: one record per\njournal entry that produced a real disk change.",
      "properties": {
        "action": {
          "$ref": "#/$defs/TimelineActionName"
        },
        "duration_ns": {
          "title": "Duration Ns",
          "type": "integer"
        },
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "from_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "From Path"
        },
        "target_asset_id": {
          "title": "Target Asset Id",
          "type": "string"
        },
        "temp_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temp Path"
        },
        "to_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "To Path"
        }
      },
      "required": [
        "event_id",
        "action",
        "target_asset_id",
        "duration_ns"
      ],
      "title": "FilesystemAction",
      "type": "object"
    },
    "MaterializationExecutionMode": {
      "description": "Mode that produced the materialization report.",
      "enum": [
        "materialize",
        "run"
      ],
      "title": "MaterializationExecutionMode",
      "type": "string"
    },
    "MaterializationFailure": {
      "additionalProperties": false,
      "description": "Per-failure record.\n\n``asset_id`` is None for non-per-asset stages (e.g. capability\nregression). ``invocation_index`` indexes into ``invocations`` when the\nfailure came from a subprocess call.",
      "properties": {
        "asset_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Asset Id"
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exit Code"
        },
        "invocation_index": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Invocation Index"
        },
        "stage": {
          "$ref": "#/$defs/FailureStage"
        },
        "stderr_tail": {
          "title": "Stderr Tail",
          "type": "string"
        }
      },
      "required": [
        "stage",
        "stderr_tail"
      ],
      "title": "MaterializationFailure",
      "type": "object"
    },
    "MaterializedAsset": {
      "additionalProperties": false,
      "description": "Per-asset success record.",
      "properties": {
        "asset_id": {
          "title": "Asset Id",
          "type": "string"
        },
        "content_hash": {
          "title": "Content Hash",
          "type": "string"
        },
        "duration_seconds": {
          "title": "Duration Seconds",
          "type": "number"
        },
        "invocation_index": {
          "title": "Invocation Index",
          "type": "integer"
        },
        "location_path": {
          "title": "Location Path",
          "type": "string"
        },
        "size_bytes": {
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "asset_id",
        "location_path",
        "content_hash",
        "size_bytes",
        "duration_seconds",
        "invocation_index"
      ],
      "title": "MaterializedAsset",
      "type": "object"
    },
    "MediaAction": {
      "additionalProperties": false,
      "description": "One phase-B media operation audit record.\n\nParallel to ``FilesystemAction``: one record per journal entry that\nproduced a real byte / probed-metadata change via ffmpeg or\nsidecar-regeneration. ``tool_invocation_index`` cross-refs into\n``MaterializationReport.invocations`` so consumers can join the two\naudit streams.",
      "properties": {
        "action": {
          "$ref": "#/$defs/TimelineActionName"
        },
        "duration_ns": {
          "title": "Duration Ns",
          "type": "integer"
        },
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "input_content_hash": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Content Hash"
        },
        "input_path": {
          "title": "Input Path",
          "type": "string"
        },
        "input_version_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Version Id"
        },
        "output_content_hash": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Content Hash"
        },
        "output_path": {
          "title": "Output Path",
          "type": "string"
        },
        "output_sidecar_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Sidecar Id"
        },
        "output_version_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Version Id"
        },
        "target_asset_id": {
          "title": "Target Asset Id",
          "type": "string"
        },
        "tool_invocation_index": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Invocation Index"
        }
      },
      "required": [
        "event_id",
        "action",
        "target_asset_id",
        "input_path",
        "output_path",
        "duration_ns"
      ],
      "title": "MediaAction",
      "type": "object"
    },
    "Outcome": {
      "description": "High-level materialize result.\n\n``unsupported`` covers both timeline-rejection and matrix-rejection.\n``tool_failed`` covers both ffmpeg subprocess errors and ffprobe parse\nfailures.",
      "enum": [
        "success",
        "unsupported",
        "tool_failed",
        "tool_missing",
        "containment_violation",
        "fs_failed",
        "media_failed",
        "corruption_failed"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "TimelineActionName": {
      "description": "All valid ``action:`` values for a timeline event.\n\nThis is the single source of truth: discriminator literals on the\nvariant classes below, the JSONPath formatter in ``validation.codes``,\nand the per-action path-field map in ``validation.semantic`` all\nreference these members instead of bare strings.",
      "enum": [
        "move_asset",
        "rename_file",
        "delete_file",
        "add_file",
        "reencode_video",
        "reencode_audio",
        "create_sidecar",
        "slow_copy_start",
        "slow_copy_commit",
        "archive_file",
        "move_between_roots",
        "remux_container",
        "edit_metadata",
        "embed_subtitle",
        "extract_subtitle",
        "remove_sidecar",
        "update_sidecar",
        "corrupt_container_header",
        "network_lag_start",
        "network_lag_commit"
      ],
      "title": "TimelineActionName",
      "type": "string"
    },
    "ToolInvocation": {
      "additionalProperties": false,
      "description": "One subprocess invocation captured for the replay bundle and report.",
      "properties": {
        "command": {
          "items": {
            "type": "string"
          },
          "title": "Command",
          "type": "array"
        },
        "duration_ns": {
          "title": "Duration Ns",
          "type": "integer"
        },
        "exit_code": {
          "title": "Exit Code",
          "type": "integer"
        },
        "tool": {
          "title": "Tool",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "tool",
        "version",
        "command",
        "exit_code",
        "duration_ns"
      ],
      "title": "ToolInvocation",
      "type": "object"
    },
    "ToolchainInfo": {
      "additionalProperties": false,
      "description": "Versions of the external tools used during materialization.\n\nShared with ``MaterializeReplayBundle`` so consumers see one shape.\nEvery field is optional because a tool may be missing on a system\nthat nevertheless succeeded at static materialize (for example,\nmkvtoolnix is only required for media-mutation modes).",
      "properties": {
        "ffmpeg": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ffmpeg"
        },
        "ffprobe": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ffprobe"
        },
        "mkvtoolnix": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mkvtoolnix"
        }
      },
      "title": "ToolchainInfo",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Top-level ``materialization.json`` body.",
  "properties": {
    "actual_duration_ns": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Actual Duration Ns"
    },
    "content_sources": {
      "items": {
        "$ref": "#/$defs/ContentSourceEvidence"
      },
      "title": "Content Sources",
      "type": "array"
    },
    "corruption_actions": {
      "items": {
        "$ref": "#/$defs/CorruptionAction"
      },
      "title": "Corruption Actions",
      "type": "array"
    },
    "execution_mode": {
      "$ref": "#/$defs/MaterializationExecutionMode",
      "default": "materialize"
    },
    "failures": {
      "items": {
        "$ref": "#/$defs/MaterializationFailure"
      },
      "title": "Failures",
      "type": "array"
    },
    "filesystem_actions": {
      "items": {
        "$ref": "#/$defs/FilesystemAction"
      },
      "title": "Filesystem Actions",
      "type": "array"
    },
    "finished_at": {
      "format": "date-time",
      "title": "Finished At",
      "type": "string"
    },
    "invocations": {
      "items": {
        "$ref": "#/$defs/ToolInvocation"
      },
      "title": "Invocations",
      "type": "array"
    },
    "materialized": {
      "items": {
        "$ref": "#/$defs/MaterializedAsset"
      },
      "title": "Materialized",
      "type": "array"
    },
    "media_actions": {
      "items": {
        "$ref": "#/$defs/MediaAction"
      },
      "title": "Media Actions",
      "type": "array"
    },
    "outcome": {
      "$ref": "#/$defs/Outcome"
    },
    "overran_duration": {
      "default": false,
      "title": "Overran Duration",
      "type": "boolean"
    },
    "platform": {
      "title": "Platform",
      "type": "string"
    },
    "requested_duration_ns": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Requested Duration Ns"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": 7,
      "title": "Schema Version",
      "type": "integer"
    },
    "speed_multiplier": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Speed Multiplier"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "toolchain": {
      "$ref": "#/$defs/ToolchainInfo"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "outcome",
    "platform",
    "started_at",
    "finished_at",
    "toolchain",
    "content_sources"
  ],
  "title": "MaterializationReport",
  "type": "object"
}
