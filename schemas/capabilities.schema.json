{
  "$defs": {
    "ContentSourceCapabilities": {
      "additionalProperties": false,
      "description": "All registered content-source providers visible to capabilities.",
      "properties": {
        "providers": {
          "items": {
            "$ref": "#/$defs/ContentSourceProviderCapability"
          },
          "title": "Providers",
          "type": "array"
        }
      },
      "title": "ContentSourceCapabilities",
      "type": "object"
    },
    "ContentSourceProviderCapability": {
      "additionalProperties": false,
      "description": "Capability report for one registered content-source provider.",
      "properties": {
        "available": {
          "title": "Available",
          "type": "boolean"
        },
        "cache_dir": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cache Dir"
        },
        "cache_writable": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cache Writable"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "required_tool": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Required Tool"
        },
        "requires_cache": {
          "title": "Requires Cache",
          "type": "boolean"
        },
        "requires_network": {
          "title": "Requires Network",
          "type": "boolean"
        },
        "sources": {
          "items": {
            "type": "string"
          },
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "name",
        "available",
        "requires_network",
        "requires_cache"
      ],
      "title": "ContentSourceProviderCapability",
      "type": "object"
    },
    "ReadyFor": {
      "additionalProperties": false,
      "description": "Forward-looking signals \u2014 which materialize modes the toolchain supports.\n\nThe current CLI only consults ``materialize_static``. The other\nflags are populated so adapter authors can skip the corresponding\nmutation-mode tests cleanly.",
      "properties": {
        "materialize_audio_recipes": {
          "title": "Materialize Audio Recipes",
          "type": "boolean"
        },
        "materialize_filesystem_mutations": {
          "title": "Materialize Filesystem Mutations",
          "type": "boolean"
        },
        "materialize_hdr_video": {
          "title": "Materialize Hdr Video",
          "type": "boolean"
        },
        "materialize_hevc_video": {
          "title": "Materialize Hevc Video",
          "type": "boolean"
        },
        "materialize_matroska_muxing_profiles": {
          "title": "Materialize Matroska Muxing Profiles",
          "type": "boolean"
        },
        "materialize_media_mutations": {
          "title": "Materialize Media Mutations",
          "type": "boolean"
        },
        "materialize_resolution_switch_video": {
          "title": "Materialize Resolution Switch Video",
          "type": "boolean"
        },
        "materialize_static": {
          "title": "Materialize Static",
          "type": "boolean"
        },
        "materialize_webm_video": {
          "title": "Materialize Webm Video",
          "type": "boolean"
        }
      },
      "required": [
        "materialize_static",
        "materialize_filesystem_mutations",
        "materialize_media_mutations",
        "materialize_hevc_video",
        "materialize_hdr_video",
        "materialize_resolution_switch_video",
        "materialize_audio_recipes",
        "materialize_matroska_muxing_profiles",
        "materialize_webm_video"
      ],
      "title": "ReadyFor",
      "type": "object"
    },
    "ToolStatus": {
      "additionalProperties": false,
      "description": "Detection outcome for one external tool.",
      "properties": {
        "found": {
          "title": "Found",
          "type": "boolean"
        },
        "meets_minimum": {
          "title": "Meets Minimum",
          "type": "boolean"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "found",
        "meets_minimum"
      ],
      "title": "ToolStatus",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Full ``capabilities --json`` payload.",
  "properties": {
    "content_sources": {
      "$ref": "#/$defs/ContentSourceCapabilities"
    },
    "ffmpeg": {
      "$ref": "#/$defs/ToolStatus"
    },
    "ffprobe": {
      "$ref": "#/$defs/ToolStatus"
    },
    "mkvtoolnix": {
      "$ref": "#/$defs/ToolStatus"
    },
    "platform": {
      "title": "Platform",
      "type": "string"
    },
    "ready_for": {
      "$ref": "#/$defs/ReadyFor"
    },
    "schema_version": {
      "const": 7,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "ffmpeg",
    "ffprobe",
    "mkvtoolnix",
    "platform",
    "content_sources",
    "ready_for"
  ],
  "title": "Capabilities",
  "type": "object"
}
