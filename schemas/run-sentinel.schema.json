{
  "$defs": {
    "RunSentinelState": {
      "description": "Run-directory lifecycle state.\n\nPlan-only callers default to ``COMPLETE``; only the materializer\never writes ``IN_PROGRESS``.",
      "enum": [
        "in_progress",
        "complete"
      ],
      "title": "RunSentinelState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Top-level ``.chaos-librarian-run`` sentinel file.",
  "properties": {
    "created_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Created At"
    },
    "created_by": {
      "title": "Created By",
      "type": "string"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "state": {
      "$ref": "#/$defs/RunSentinelState",
      "default": "complete"
    }
  },
  "required": [
    "run_id",
    "schema_version",
    "created_by"
  ],
  "title": "RunSentinel",
  "type": "object"
}
