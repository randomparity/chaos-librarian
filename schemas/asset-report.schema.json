{
  "$defs": {
    "AssetHistoryEntry": {
      "additionalProperties": false,
      "description": "One journal event that targets this asset, verbatim.",
      "properties": {
        "action": {
          "title": "Action",
          "type": "string"
        },
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "logical_time_ns": {
          "title": "Logical Time Ns",
          "type": "integer"
        },
        "state_delta": {
          "additionalProperties": true,
          "title": "State Delta",
          "type": "object"
        }
      },
      "required": [
        "logical_time_ns",
        "event_id",
        "action",
        "state_delta"
      ],
      "title": "AssetHistoryEntry",
      "type": "object"
    },
    "AssetSnapshot": {
      "additionalProperties": false,
      "description": "A point-in-time view of one asset's location + version binding.",
      "properties": {
        "content_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Hash"
        },
        "location_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Location Path"
        },
        "probed": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProbedMedia"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "version_id": {
          "title": "Version Id",
          "type": "string"
        },
        "version_index": {
          "title": "Version Index",
          "type": "integer"
        }
      },
      "required": [
        "location_path",
        "version_id",
        "version_index"
      ],
      "title": "AssetSnapshot",
      "type": "object"
    },
    "ProbedMedia": {
      "additionalProperties": false,
      "description": "Output of ``ffprobe -show_format -show_streams`` mapped into a model.",
      "properties": {
        "container": {
          "title": "Container",
          "type": "string"
        },
        "duration_seconds": {
          "title": "Duration Seconds",
          "type": "number"
        },
        "size_bytes": {
          "title": "Size Bytes",
          "type": "integer"
        },
        "streams": {
          "items": {
            "$ref": "#/$defs/ProbedStream"
          },
          "title": "Streams",
          "type": "array"
        }
      },
      "required": [
        "container",
        "duration_seconds",
        "size_bytes",
        "streams"
      ],
      "title": "ProbedMedia",
      "type": "object"
    },
    "ProbedStream": {
      "additionalProperties": false,
      "description": "One stream from ``ffprobe -show_streams``.\n\nOptional fields are populated only for the matching ``kind``; ffprobe\nsilently omits the others, and ``exclude_none=True`` keeps the serialized\noutput compact.",
      "properties": {
        "channels": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Channels"
        },
        "codec": {
          "title": "Codec",
          "type": "string"
        },
        "default": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default"
        },
        "forced": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Forced"
        },
        "fps": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fps"
        },
        "height": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Height"
        },
        "kind": {
          "enum": [
            "video",
            "audio",
            "subtitle"
          ],
          "title": "Kind",
          "type": "string"
        },
        "language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Language"
        },
        "sample_rate": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sample Rate"
        },
        "width": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Width"
        }
      },
      "required": [
        "kind",
        "codec"
      ],
      "title": "ProbedStream",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Per-asset history report \u2014 initial snapshot, ordered history, current snapshot.\n\n``current`` is ``None`` if the asset has been deleted; ``history``\nstill includes the ``delete_file`` entry in that case.",
  "properties": {
    "asset_id": {
      "title": "Asset Id",
      "type": "string"
    },
    "current": {
      "anyOf": [
        {
          "$ref": "#/$defs/AssetSnapshot"
        },
        {
          "type": "null"
        }
      ]
    },
    "history": {
      "items": {
        "$ref": "#/$defs/AssetHistoryEntry"
      },
      "title": "History",
      "type": "array"
    },
    "initial": {
      "$ref": "#/$defs/AssetSnapshot"
    },
    "schema_version": {
      "const": 2,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "asset_id",
    "initial",
    "current"
  ],
  "title": "AssetReport",
  "type": "object"
}
