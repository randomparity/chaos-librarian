{
  "$defs": {
    "AssetHistoryEntry": {
      "additionalProperties": false,
      "description": "One journal event that targets this asset, verbatim.",
      "properties": {
        "action": {
          "title": "Action",
          "type": "string"
        },
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "logical_time_ns": {
          "title": "Logical Time Ns",
          "type": "integer"
        },
        "state_delta": {
          "additionalProperties": true,
          "title": "State Delta",
          "type": "object"
        }
      },
      "required": [
        "logical_time_ns",
        "event_id",
        "action",
        "state_delta"
      ],
      "title": "AssetHistoryEntry",
      "type": "object"
    },
    "AssetSnapshot": {
      "additionalProperties": false,
      "description": "A point-in-time view of one asset's location + version binding.",
      "properties": {
        "content_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Hash"
        },
        "corruption": {
          "anyOf": [
            {
              "$ref": "#/$defs/CorruptionRecord"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "location_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Location Path"
        },
        "probed": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProbedMedia"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "version_id": {
          "title": "Version Id",
          "type": "string"
        },
        "version_index": {
          "title": "Version Index",
          "type": "integer"
        }
      },
      "required": [
        "location_path",
        "version_id",
        "version_index"
      ],
      "title": "AssetSnapshot",
      "type": "object"
    },
    "CorruptionRecord": {
      "additionalProperties": false,
      "properties": {
        "byte_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Byte Count"
        },
        "byte_start": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Byte Start"
        },
        "corruptor": {
          "title": "Corruptor",
          "type": "string"
        },
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "title": "Metadata",
          "type": "object"
        },
        "packet_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Packet Count"
        },
        "packet_start": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Packet Start"
        },
        "profile": {
          "$ref": "#/$defs/ProfileName"
        },
        "seed_material": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed Material"
        },
        "stream": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stream"
        }
      },
      "required": [
        "profile",
        "event_id",
        "corruptor"
      ],
      "title": "CorruptionRecord",
      "type": "object"
    },
    "ParentKind": {
      "description": "Playable/listenable parent kinds for variants and assets.",
      "enum": [
        "movie",
        "episode",
        "track"
      ],
      "title": "ParentKind",
      "type": "string"
    },
    "PathHistoryEntry": {
      "additionalProperties": false,
      "description": "One filesystem-affecting event projected for a single asset.\n\nDerived from the journal by ``derive_path_history``. Mirrors the\nverbatim ``AssetHistoryEntry`` but flattens the path-bearing\n``state_delta`` keys into typed ``str | None`` fields so external\nconsumers (voom-v2 adapter) can read them without parsing dicts.",
      "properties": {
        "action": {
          "$ref": "#/$defs/TimelineActionName"
        },
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "from_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "From Path"
        },
        "logical_time_ns": {
          "title": "Logical Time Ns",
          "type": "integer"
        },
        "temp_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temp Path"
        },
        "to_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "To Path"
        }
      },
      "required": [
        "event_id",
        "action",
        "logical_time_ns"
      ],
      "title": "PathHistoryEntry",
      "type": "object"
    },
    "ProbedChapter": {
      "additionalProperties": false,
      "description": "One chapter from ``ffprobe -show_chapters``.",
      "properties": {
        "end_ms": {
          "minimum": 0,
          "title": "End Ms",
          "type": "integer"
        },
        "index": {
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "start_ms": {
          "minimum": 0,
          "title": "Start Ms",
          "type": "integer"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        }
      },
      "required": [
        "index",
        "start_ms",
        "end_ms"
      ],
      "title": "ProbedChapter",
      "type": "object"
    },
    "ProbedMedia": {
      "additionalProperties": false,
      "description": "Output of ``ffprobe`` mapped into a model.",
      "properties": {
        "chapters": {
          "items": {
            "$ref": "#/$defs/ProbedChapter"
          },
          "title": "Chapters",
          "type": "array"
        },
        "container": {
          "title": "Container",
          "type": "string"
        },
        "duration_seconds": {
          "title": "Duration Seconds",
          "type": "number"
        },
        "size_bytes": {
          "title": "Size Bytes",
          "type": "integer"
        },
        "streams": {
          "items": {
            "$ref": "#/$defs/ProbedStream"
          },
          "title": "Streams",
          "type": "array"
        }
      },
      "required": [
        "container",
        "duration_seconds",
        "size_bytes",
        "streams"
      ],
      "title": "ProbedMedia",
      "type": "object"
    },
    "ProbedStream": {
      "additionalProperties": false,
      "description": "One stream from ``ffprobe -show_streams``.\n\nOptional fields are populated only for the matching ``kind``; ffprobe\nsilently omits the others, and ``exclude_none=True`` keeps the serialized\noutput compact.",
      "properties": {
        "attached_pic": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attached Pic"
        },
        "channel_layout": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Channel Layout"
        },
        "channels": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Channels"
        },
        "codec": {
          "title": "Codec",
          "type": "string"
        },
        "default": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default"
        },
        "forced": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Forced"
        },
        "fps": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fps"
        },
        "height": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Height"
        },
        "kind": {
          "$ref": "#/$defs/StreamKind"
        },
        "language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Language"
        },
        "role": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        },
        "sample_rate": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sample Rate"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "width": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Width"
        }
      },
      "required": [
        "kind",
        "codec"
      ],
      "title": "ProbedStream",
      "type": "object"
    },
    "ProfileName": {
      "enum": [
        "malformed-media",
        "performance-smoke",
        "performance-scale",
        "performance-stress",
        "network-fs-lag",
        "filesystem-artifacts",
        "negative-oracle",
        "fuzz-smoke",
        "fuzz-regression"
      ],
      "title": "ProfileName",
      "type": "string"
    },
    "StreamKind": {
      "description": "Kind of a probed media stream.",
      "enum": [
        "video",
        "audio",
        "subtitle"
      ],
      "title": "StreamKind",
      "type": "string"
    },
    "TimelineActionName": {
      "description": "All valid ``action:`` values for a timeline event.\n\nThis is the single source of truth: discriminator literals on the\nvariant classes below, the JSONPath formatter in ``validation.codes``,\nand the per-action path-field map in ``validation.semantic`` all\nreference these members instead of bare strings.",
      "enum": [
        "move_asset",
        "rename_file",
        "delete_file",
        "add_file",
        "reencode_video",
        "reencode_audio",
        "create_sidecar",
        "slow_copy_start",
        "slow_copy_commit",
        "archive_file",
        "move_between_roots",
        "remux_container",
        "edit_metadata",
        "embed_subtitle",
        "extract_subtitle",
        "remove_sidecar",
        "update_sidecar",
        "corrupt_container_header",
        "truncate_file",
        "corrupt_packet_range",
        "write_invalid_duration_metadata",
        "touch_mtime",
        "wrong_oracle_hash",
        "network_lag_start",
        "network_lag_commit",
        "renumber_episode",
        "move_episode_to_season",
        "rename_season",
        "renumber_disc",
        "move_track_to_disc"
      ],
      "title": "TimelineActionName",
      "type": "string"
    },
    "VersionHistoryEntry": {
      "additionalProperties": false,
      "description": "One version-affecting journal event projected for a single asset.\n\nDerived from the journal by ``derive_version_history``. Mirrors\nSprint 6's ``PathHistoryEntry`` shape for the version-allocating\nsubset of actions (reencode_video / reencode_audio / remux_container\n/ edit_metadata / embed_subtitle). ``extract_subtitle`` does NOT\nappear here \u2014 it's a read-only extract that allocates a sidecar but\nnot a version.",
      "properties": {
        "action": {
          "$ref": "#/$defs/TimelineActionName"
        },
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "input_version_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Version Id"
        },
        "logical_time_ns": {
          "title": "Logical Time Ns",
          "type": "integer"
        },
        "output_version_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Version Id"
        },
        "state_delta_summary": {
          "additionalProperties": true,
          "title": "State Delta Summary",
          "type": "object"
        }
      },
      "required": [
        "event_id",
        "action",
        "logical_time_ns"
      ],
      "title": "VersionHistoryEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Per-asset history report \u2014 initial snapshot, ordered history, current snapshot.\n\n``current`` is ``None`` if the asset has been deleted; ``history``\nstill includes the ``delete_file`` entry in that case.",
  "properties": {
    "album_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Album Id"
    },
    "artist_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Artist Id"
    },
    "asset_id": {
      "title": "Asset Id",
      "type": "string"
    },
    "bundle_id": {
      "title": "Bundle Id",
      "type": "string"
    },
    "current": {
      "anyOf": [
        {
          "$ref": "#/$defs/AssetSnapshot"
        },
        {
          "type": "null"
        }
      ]
    },
    "disc_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Disc Id"
    },
    "episode_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Episode Id"
    },
    "history": {
      "items": {
        "$ref": "#/$defs/AssetHistoryEntry"
      },
      "title": "History",
      "type": "array"
    },
    "initial": {
      "$ref": "#/$defs/AssetSnapshot"
    },
    "movie_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Movie Id"
    },
    "parent_id": {
      "title": "Parent Id",
      "type": "string"
    },
    "parent_kind": {
      "$ref": "#/$defs/ParentKind"
    },
    "path_history": {
      "items": {
        "$ref": "#/$defs/PathHistoryEntry"
      },
      "title": "Path History",
      "type": "array"
    },
    "schema_version": {
      "const": 9,
      "title": "Schema Version",
      "type": "integer"
    },
    "season_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Season Id"
    },
    "series_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Series Id"
    },
    "track_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Track Id"
    },
    "variant_id": {
      "title": "Variant Id",
      "type": "string"
    },
    "version_history": {
      "items": {
        "$ref": "#/$defs/VersionHistoryEntry"
      },
      "title": "Version History",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "asset_id",
    "parent_kind",
    "parent_id",
    "variant_id",
    "bundle_id",
    "initial",
    "current"
  ],
  "title": "AssetReport",
  "type": "object"
}
